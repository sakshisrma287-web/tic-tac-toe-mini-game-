/*
    Tic Tac Toe - Console Mini Game (C++)
    --------------------------------------
    Demonstrates:
      - Arrays (2D board representation)
      - Loops (game loop, board printing, win checking)
      - Conditional logic (turn switching, win/draw detection)
      - Functions (modular game logic)
      - Replay functionality
*/

#include <iostream>
#include <limits>
using namespace std;

const int SIZE = 3;

// Prints the current state of the board
void printBoard(char board[SIZE][SIZE]) {
    cout << "\n";
    for (int i = 0; i < SIZE; i++) {
        cout << " ";
        for (int j = 0; j < SIZE; j++) {
            cout << board[i][j];
            if (j < SIZE - 1) cout << " | ";
        }
        cout << "\n";
        if (i < SIZE - 1) cout << "-----------\n";
    }
    cout << "\n";
}

// Resets the board to empty cells (1-9 placeholders for easy input reference)
void initBoard(char board[SIZE][SIZE]) {
    int num = 1;
    for (int i = 0; i < SIZE; i++)
        for (int j = 0; j < SIZE; j++)
            board[i][j] = '0' + num++;
}

// Converts a 1-9 move into row/col indices
bool getRowCol(int move, int &row, int &col) {
    if (move < 1 || move > 9) return false;
    move--; // zero-index
    row = move / SIZE;
    col = move % SIZE;
    return true;
}

// Checks if a move is valid (cell not already taken)
bool isValidMove(char board[SIZE][SIZE], int move) {
    int row, col;
    if (!getRowCol(move, row, col)) return false;
    return board[row][col] != 'X' && board[row][col] != 'O';
}

// Places a player's mark on the board
void makeMove(char board[SIZE][SIZE], int move, char player) {
    int row, col;
    getRowCol(move, row, col);
    board[row][col] = player;
}

// Checks rows, columns, and diagonals for a win
bool checkWin(char board[SIZE][SIZE], char player) {
    // Rows and columns
    for (int i = 0; i < SIZE; i++) {
        if (board[i][0] == player && board[i][1] == player && board[i][2] == player)
            return true;
        if (board[0][i] == player && board[1][i] == player && board[2][i] == player)
            return true;
    }
    // Diagonals
    if (board[0][0] == player && board[1][1] == player && board[2][2] == player)
        return true;
    if (board[0][2] == player && board[1][1] == player && board[2][0] == player)
        return true;

    return false;
}

// Checks if the board is completely filled (draw condition)
bool isBoardFull(char board[SIZE][SIZE]) {
    for (int i = 0; i < SIZE; i++)
        for (int j = 0; j < SIZE; j++)
            if (board[i][j] != 'X' && board[i][j] != 'O')
                return false;
    return true;
}

// Reads a valid integer move from the user, with input validation
int getMoveInput(char board[SIZE][SIZE], char player) {
    int move;
    while (true) {
        cout << "Player " << player << ", enter your move (1-9): ";
        cin >> move;

        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input. Please enter a number.\n";
            continue;
        }

        if (!isValidMove(board, move)) {
            cout << "That move is invalid or the cell is already taken. Try again.\n";
            continue;
        }

        return move;
    }
}

// Plays a single round of Tic Tac Toe
void playGame() {
    char board[SIZE][SIZE];
    initBoard(board);

    char currentPlayer = 'X';
    bool gameWon = false;

    cout << "\n=== TIC TAC TOE ===\n";
    cout << "Players take turns picking a cell number 1-9 as shown below:\n";
    printBoard(board);

    while (true) {
        int move = getMoveInput(board, currentPlayer);
        makeMove(board, move, currentPlayer);

        printBoard(board);

        if (checkWin(board, currentPlayer)) {
            cout << "*** Player " << currentPlayer << " WINS! Congratulations! ***\n";
            gameWon = true;
            break;
        }

        if (isBoardFull(board)) {
            cout << "It's a DRAW! The board is full.\n";
            break;
        }

        // Switch turns
        currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
    }

    (void)gameWon; // reserved for potential scoring extension
}

// Asks the user if they'd like to replay
bool askReplay() {
    char choice;
    while (true) {
        cout << "Play again? (y/n): ";
        cin >> choice;

        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            continue;
        }

        choice = tolower(choice);
        if (choice == 'y') return true;
        if (choice == 'n') return false;

        cout << "Please enter 'y' or 'n'.\n";
    }
}

int main() {
    cout << "Welcome to Console Tic Tac Toe!\n";

    do {
        playGame();
    } while (askReplay());

    cout << "\nThanks for playing! Goodbye.\n";
    return 0;
}